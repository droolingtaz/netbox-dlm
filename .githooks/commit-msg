#!/bin/sh
# Enforce Conventional Commits 1.0.0 on the commit subject line.
# https://www.conventionalcommits.org/en/v1.0.0/#specification
#
# Enable once per clone:  git config core.hooksPath .githooks

msg_file="$1"

# Drop git's comment lines and any leading blank lines before checking.
msg=$(grep -v '^#' "$msg_file" | sed '/./,$!d')
subject=$(printf '%s\n' "$msg" | sed -n '1p')
second=$(printf '%s\n' "$msg" | sed -n '2p')

# Let git's own generated subjects through (merges, reverts, autosquash).
case "$subject" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

types='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test'

if ! printf '%s\n' "$subject" | grep -Eq "^($types)(\([a-z0-9._/-]+\))?!?: [^ ].*$"; then
  cat >&2 <<EOF
commit-msg: subject is not a Conventional Commit:

  $subject

Expected:  <type>[optional scope][!]: <description>
Types:     ${types}
Examples:  feat(models): add EoL date to SoftwareVersion
           fix: import views.py in urls.py to resolve NoReverseMatch
           feat!: drop NetBox 4.4 support

See https://www.conventionalcommits.org/en/v1.0.0/#specification
EOF
  exit 1
fi

if [ -n "$second" ]; then
  echo "commit-msg: the body must be separated from the subject by a blank line." >&2
  exit 1
fi
